<nav class="nav nav--{{ navTheme or 'light' }}"{% if navId %} id="{{ navId }}"{% endif %}>
    <a href="/" class="nav__wordmark">
      <img class="nav__logo nav__logo--dark" src="/assets/images/resolve-advisory-logo.png" alt="Resolve Advisory">
      <img class="nav__logo nav__logo--light" src="/assets/images/resolve-white-logo.png" alt="Resolve Advisory">
    </a>
    <div class="nav__links" id="primary-navigation">
      {% for item in navigation %}
      <a href="{{ item.url }}"{% if navActive == item.key %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </div>
    <a href="mailto:aakers@resolve-advisory.com?subject=Request%20a%20conversation" class="nav__cta">Request a conversation</a>
    <button class="nav__hamburger" type="button" aria-label="Toggle navigation" aria-controls="primary-navigation" aria-expanded="false" onclick="const nav=this.closest('.nav'); nav.classList.toggle('open'); this.setAttribute('aria-expanded', nav.classList.contains('open'))">
      <span></span><span></span><span></span>
    </button>
  </nav>
