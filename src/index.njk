<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pages.home.seo.title }}</title>
  <meta name="description" content="{{ pages.home.seo.description }}">
  <link rel="stylesheet" href="/assets/css/styles.css">
  <style>
    /* ── Hero ── */
    .hero {
      position: relative;
      min-height: 100vh;
      background: var(--charcoal);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(90deg, rgba(26,26,36,0.86) 0%, rgba(26,26,36,0.72) 36%, rgba(26,26,36,0.18) 100%),
        linear-gradient(0deg, rgba(26,26,36,0.25), rgba(26,26,36,0.25));
      z-index: 1;
      pointer-events: none;
    }
    .hero__text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: calc(var(--nav-h) + 60px) var(--pad-x) 80px;
      position: relative;
      z-index: 2;
      width: 60%;
      max-width: none;
    }
    .hero__headline {
      font-family: var(--font-serif);
      font-size: clamp(38px, 4.8vw, 72px);
      font-weight: 400;
      line-height: 1.07;
      color: var(--warm-white);
      margin-bottom: 42px;
      max-width: 760px;
    }
    .hero__headline em {
      font-style: italic;
      color: rgba(253,250,247,0.88);
    }
    .hero__rule {
      width: 40px; height: 1px;
      background: rgba(253,250,247,0.35);
      margin-bottom: 34px;
    }
    .hero__body {
      font-size: clamp(18px, 1.28vw, 20px);
      font-weight: 400;
      line-height: 1.72;
      color: rgba(253,250,247,0.82);
      max-width: 540px;
    }
    .hero__body p + p { margin-top: 1em; }
    .hero__cta { margin-top: 54px; }
    .hero__image {
      position: absolute;
      inset: 0;
      overflow: hidden;
      z-index: 0;
    }
    .hero__image .img-ph {
      min-height: 100%;
      background: #2a2520;
      height: 100%;
    }
    .hero__image .site-image {
      min-height: 100vh;
      width: 100%;
      height: 100vh;
      opacity: 0.92;
    }
    .hero__image .img-ph span { color: rgba(253,250,247,0.2); }

    /* ── Home 2: A different way ── */
    .home-2 {
      display: grid;
      grid-template-columns: 50fr 50fr;
      min-height: 80vh;
    }
    .home-2__text {
      padding: clamp(70px, 9vw, 110px) var(--pad-x);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .home-2__image { position: relative; overflow: hidden; min-width: 0; }
    .home-2__image .site-image {
      width: 100%;
      height: 100%;
      min-height: 560px;
      object-fit: cover;
    }
    .home-2__tagline {
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(28,28,40,0.68);
      margin-bottom: 20px;
    }
    .home-2__heading {
      font-family: var(--font-serif);
      font-size: clamp(38px, 4.5vw, 64px);
      font-weight: 400;
      line-height: 1.08;
      margin-bottom: 36px;
    }
    .home-2__heading em { font-style: italic; }
    .home-2__footer-tag {
      margin-top: 46px;
      font-size: clamp(14px, 1.25vw, 18px);
      font-weight: 500;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(28,28,40,0.74);
    }
    .home-2__footer-rule {
      width: 42px; height: 1px;
      background: rgba(28,28,40,0.25);
      margin-top: 10px;
    }

    /* ── Home 3: I work with one side ── */
    .home-3 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 80vh;
    }
    .home-3__image { position: relative; overflow: hidden; min-width: 0; }
    .home-3__image .img-ph { background: #C4BDB5; height: 100%; min-height: 560px; }
    .home-3__image .site-image {
      width: 100%;
      height: 100%;
      min-height: 560px;
      object-fit: cover;
    }
    .home-3__text {
      padding: clamp(70px, 9vw, 110px) var(--pad-x);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .home-3__italic {
      font-family: var(--font-serif);
      font-size: clamp(17px, 1.8vw, 22px);
      font-style: italic;
      font-weight: 400;
      color: var(--gold);
      margin-top: 28px;
      max-width: 380px;
      line-height: 1.5;
    }

    /* ── Home 4: Most conflicts escalate ── */
    .home-4 {
      background: transparent;
      min-height: 80vh;
      padding: clamp(70px, 9vw, 110px) var(--pad-x);
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
    }
    .home-4__bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 1;
    }
    .home-4__inner {
      max-width: 1320px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(360px, 0.75fr);
      gap: clamp(56px, 7vw, 96px);
      align-items: center;
      position: relative;
      z-index: 1;
    }
    .home-4__left {}
    .home-4__heading {
      font-family: var(--font-serif);
      font-size: clamp(38px, 4.5vw, 62px);
      font-weight: 400;
      line-height: 1.08;
      color: var(--text);
      margin-bottom: 32px;
    }
    .home-4__body {
      font-size: clamp(17px, 1.2vw, 19px);
      font-weight: 400;
      line-height: 1.78;
      color: rgba(28,28,40,0.94);
      max-width: 660px;
    }
    .home-4__body p + p { margin-top: 1.1em; }
    .home-4__right {
      border-left: 1px solid rgba(28,28,40,0.16);
      padding-left: 60px;
    }
    .home-4__quote {
      font-family: var(--font-serif);
      font-size: clamp(20px, 2.2vw, 28px);
      font-weight: 400;
      font-style: italic;
      line-height: 1.5;
      color: rgba(28,28,40,0.86);
    }
    .home-4__quote-rule {
      width: 40px; height: 1px;
      background: var(--gold);
      margin-top: 24px;
    }

    /* ── Home 5: Where this work is most useful ── */
    .home-5 {
      background: var(--cream-mid);
      padding: clamp(70px, 9vw, 110px) var(--pad-x) clamp(24px, 3vw, 36px);
      position: relative;
      overflow: hidden;
    }
    .home-5 + .cta-banner {
      padding-top: clamp(24px, 3vw, 36px);
      padding-bottom: clamp(24px, 3vw, 36px);
    }
    .home-5__bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.24;
    }
    .home-5__inner { max-width: var(--max-w); margin: 0 auto; position: relative; z-index: 1; }
    .home-5__header { margin-bottom: 60px; }
    .home-5__heading {
      font-family: var(--font-serif);
      font-size: clamp(38px, 4.5vw, 64px);
      font-weight: 400;
      line-height: 1.08;
      max-width: 600px;
      margin-bottom: 24px;
    }
    .home-5__intro {
      font-size: clamp(17px, 1.18vw, 19px);
      font-weight: 400;
      line-height: 1.78;
      color: rgba(28,28,40,0.8);
      max-width: 640px;
    }
    .home-5__intro p + p { margin-top: 0.9em; }
    .home-5__cols {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      border-top: 1px solid var(--divider);
      margin-top: 48px;
    }
    .home-5__col {
      padding: 48px 40px 48px 0;
      border-right: 1px solid var(--divider);
    }
    .home-5__col:last-child { border-right: none; padding-right: 0; }
    .home-5__col h3 {
      font-family: var(--font-serif);
      font-size: clamp(34px, 3.4vw, 48px);
      font-weight: 500;
      line-height: 1.05;
      margin-bottom: 20px;
    }
    .home-5__col-rule {
      width: 28px; height: 1px;
      background: var(--gold);
      margin-bottom: 20px;
    }
    .home-5__col ul {
      display: flex; flex-direction: column; gap: 14px;
    }
    .home-5__col li {
      font-size: clamp(16.5px, 1.1vw, 18px);
      font-weight: 400;
      line-height: 1.7;
      color: rgba(28,28,40,0.82);
    }

    @media (max-width: 960px) {
      .home-2, .home-3 { grid-template-columns: 1fr; }
      .hero__text { width: 100%; }
      .hero__image { min-height: 300px; }
      .home-2__image { min-height: 300px; }
      .home-2__image .site-image,
      .home-3__image .site-image {
        min-height: 340px;
      }
      .home-3__text { order: -1; }
      .home-4__inner { grid-template-columns: 1fr; gap: 40px; }
      .home-4__right { border-left: none; padding-left: 0; border-top: 1px solid rgba(28,28,40,0.16); padding-top: 40px; }
      .home-5__cols { grid-template-columns: 1fr; }
      .home-5__col { border-right: none; border-bottom: 1px solid var(--divider); padding-right: 0; }
      .home-5__col[style] { padding-left: 0 !important; }
      .home-5__col:last-child { border-bottom: none; }
    }
    @media (max-width: 520px) {
      .hero__headline {
        font-size: clamp(34px, 11vw, 44px);
      }
    }
  </style>
</head>
<body class="page page--hero">

  <!-- NAV -->
  <nav class="nav nav--dark" id="nav">
    <a href="/" class="nav__wordmark">
      <img class="nav__logo nav__logo--dark" src="/assets/images/resolve-advisory-logo.png" alt="Resolve Advisory">
      <img class="nav__logo nav__logo--light" src="/assets/images/resolve-white-logo.png" alt="Resolve Advisory">
    </a>
    <div class="nav__links">
      <a href="/" class="active">Home</a>
      <a href="/how-it-works/">How it works</a>
      <a href="/situations/">Situations</a>
      <a href="/insights/">Insights</a>
      <a href="/about/">About</a>
      <a href="/faq/">FAQ</a>
    </div>
    <a href="mailto:aakers@resolve-advisory.com?subject=Request%20a%20conversation" class="nav__cta">Request a conversation</a>
    <button class="nav__hamburger" aria-label="Open menu" onclick="this.closest('.nav').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- HERO -->
  <section class="hero" id="hero">
    <div class="hero__text">
      <h1 class="hero__headline">
        {{ pages.home.hero.title.line1 }}<br>{{ pages.home.hero.title.line2 }}<br><em>{{ pages.home.hero.title.emphasis }}</em>
      </h1>
      <div class="hero__rule"></div>
      <div class="hero__body">
        {% for paragraph in pages.home.hero.paragraphs %}
        <p>{{ paragraph | safe }}</p>
        {% endfor %}
      </div>
      <div class="hero__cta">
        <a href="mailto:aakers@resolve-advisory.com?subject=Request%20a%20conversation" class="btn btn--hero-light">{{ pages.home.hero.ctaLabel }}</a>
      </div>
    </div>
    <div class="hero__image">
      <img class="site-image site-image--right" src="/assets/images/hero-page-1.webp" alt="Light entering through a doorway in a quiet architectural interior">
    </div>
  </section>

  <!-- HOME 2: A different way -->
  <section class="home-2">
    <div class="home-2__text">
      <div class="rule"></div>
      <h2 class="home-2__heading">{{ pages.home.approach.heading.text }} <em>{{ pages.home.approach.heading.emphasis }}</em></h2>
      <div class="body-text">
        {% for paragraph in pages.home.approach.paragraphs %}
        <p>{{ paragraph | safe }}</p>
        {% endfor %}
      </div>
      <div class="home-2__footer-tag">{{ pages.home.approach.footerTag | safe }}</div>
      <div class="home-2__footer-rule"></div>
    </div>
    <div class="home-2__image">
      <img class="site-image site-image--right" src="/assets/images/home-page-2.webp" alt="Sunlit stone wall and architectural opening">
    </div>
  </section>

  <!-- HOME 3: I work with one side -->
  <section class="home-3">
    <div class="home-3__image">
      <img class="site-image site-image--left" src="/assets/images/home-page-3.webp" alt="Quiet interior with chair, bookshelves, and warm window light">
    </div>
    <div class="home-3__text">
      <div class="rule"></div>
      <h2 class="h2" style="max-width:400px;">{{ pages.home.oneSide.heading.line1 }}<br>{{ pages.home.oneSide.heading.line2 }}</h2>
      <div class="rule"></div>
      <div class="body-text" style="max-width:440px;">
        {% for paragraph in pages.home.oneSide.paragraphs %}
        <p>{{ paragraph }}</p>
        {% endfor %}
      </div>
      <p class="home-3__italic">{{ pages.home.oneSide.italic }}</p>
    </div>
  </section>

  <!-- HOME 4: Most conflicts escalate -->
  <section class="home-4">
    <img class="home-4__bg" src="/assets/images/home-page-4.webp" alt="">
    <div class="home-4__inner">
      <div class="home-4__left">
        <div class="rule" style="background:rgba(184,145,106,0.6);"></div>
        <h2 class="home-4__heading">{{ pages.home.escalation.heading.line1 }}<br>{{ pages.home.escalation.heading.line2 }}<br>{{ pages.home.escalation.heading.line3 }}</h2>
        <div class="home-4__body">
          {% for paragraph in pages.home.escalation.paragraphs %}
          <p>{{ paragraph }}</p>
          {% endfor %}
        </div>
      </div>
      <div class="home-4__right">
        <p class="home-4__quote">{{ pages.home.escalation.quote }}</p>
        <div class="home-4__quote-rule"></div>
      </div>
    </div>
  </section>

  <!-- HOME 5: Where this work is most useful -->
  <section class="home-5">
    <img class="home-5__bg" src="/assets/images/home-page-5.webp" alt="">
    <div class="home-5__inner">
      <div class="home-5__header">
        <div class="rule"></div>
        <h2 class="home-5__heading">{{ pages.home.useCases.heading }}</h2>
        <div class="home-5__intro">
          {% for paragraph in pages.home.useCases.intro %}
          <p>{{ paragraph }}</p>
          {% endfor %}
        </div>
      </div>
      <div class="home-5__cols">
        {% for column in pages.home.useCases.columns %}
        <div class="home-5__col"{% if not loop.first %} style="padding-left:40px;"{% endif %}>
          <h3>{{ column.title }}</h3>
          <div class="home-5__col-rule"></div>
          <ul>
            {% for item in column.items %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <div class="cta-banner">
    <div class="cta-banner__inner">
      <p class="cta-banner__text">{{ pages.home.ctaBanner.text }}</p>
      <a href="mailto:aakers@resolve-advisory.com?subject=Request%20a%20conversation" class="btn btn--dark">{{ pages.home.ctaBanner.ctaLabel }}</a>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer__grid">
      <div class="footer__brand">
        <span class="footer__wordmark"><img src="/assets/images/resolve-white-logo.png" alt="Resolve Advisory"></span>
        <p class="footer__tagline">Strategic advisory for complex situations and difficult conversations.</p>
      </div>
      <div>
        <span class="footer__col-head">Navigation</span>
        <div class="footer__links">
          <a href="/about/">About</a>
          <a href="/situations/">Situations</a>
          <a href="/how-it-works/">How It Works</a>
          <a href="/faq/">FAQ</a>
        </div>
      </div>
      <div>
        <span class="footer__col-head">Disclaimer</span>
        <p class="footer__disclaimer">Resolve Advisory does not provide legal, tax, investment, psychological, or therapeutic advice.</p>
      </div>
      <div>
        <span class="footer__col-head">Contact</span>
        <div class="footer__links">
          <a href="tel:+19177508987">P: +1 917 750 8987</a>
          <a href="mailto:aakers@resolve-advisory.com">E: aakers@resolve-advisory.com</a>
        </div>
      </div>
    </div>
    {% include "footer-newsletter.njk" %}

    <div class="footer__bottom">
      <span>© 2026 Resolve Advisory. All rights reserved.</span>
      <a href="#">Privacy</a>
    </div>
  </footer>
</script>
  <script src="/assets/js/contact-modal-data.js"></script>
  <script src="/assets/js/contact-modal.js"></script>
  <script src="/assets/js/nav-scroll.js"></script>
</body>
</html>
