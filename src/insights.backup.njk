<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Insights — Resolve Advisory</title>
  <link rel="stylesheet" href="/assets/css/styles.css">
  <style>
    /* Hero */
    .ins-hero {
      display: grid;
      grid-template-columns: 50fr 50fr;
      min-height: calc(100vh - var(--nav-h));
    }
    .ins-hero__text {
      padding: clamp(60px,8vw,100px) var(--pad-x);
      display: flex; flex-direction: column; justify-content: center;
    }
    .ins-hero__image {
      position: relative;
      overflow: hidden;
      min-width: 0;
    }
    .ins-hero__image .site-image {
      width: 100%;
      height: 100%;
      min-height: calc(100vh - var(--nav-h));
      object-fit: cover;
      object-position: center center;
    }

    /* Featured insight */
    .featured {
      padding: clamp(70px,9vw,110px) var(--pad-x);
      background: var(--cream);
    }
    .featured__inner {
      max-width: var(--max-w);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 72px;
      align-items: center;
    }
    .featured__img-wrap {
      position: relative;
      overflow: hidden;
    }
    .featured__img-wrap .site-image {
      min-height: 480px;
      object-fit: cover;
    }
    .featured__title {
      font-family: var(--font-serif);
      font-size: clamp(28px,3.2vw,46px);
      font-weight: 400;
      line-height: 1.1;
      margin-bottom: 20px;
    }
    .featured__rule {
      width: 36px;
      height: 1px;
      background: var(--gold);
      margin-bottom: 20px;
    }
    .featured__excerpt {
      font-size: clamp(17px, 1.18vw, 19px);
      font-weight: 400;
      line-height: 1.78;
      color: rgba(28,28,40,0.86);
      margin-bottom: 28px;
    }

    @media (max-width: 960px) {
      .ins-hero { grid-template-columns: 1fr; }
      .ins-hero__image { order: 2; min-height: 300px; }
      .ins-hero__image .site-image { min-height: 340px; }
      .featured__inner { grid-template-columns: 1fr; gap: 36px; }
      .featured__img-wrap .site-image { min-height: 340px; }
    }
  </style>
</head>
<body class="page">

  <nav class="nav nav--light">
    <a href="/" class="nav__wordmark">
      <img class="nav__logo nav__logo--dark" src="/assets/images/resolve-advisory-logo.png" alt="Resolve Advisory">
      <img class="nav__logo nav__logo--light" src="/assets/images/resolve-white-logo.png" alt="Resolve Advisory">
    </a>
    <div class="nav__links">
      <a href="/how-it-works/">How it works</a>
      <a href="/situations/">Situations</a>
      <a href="/about/">About</a>
      <a href="/faq/">FAQ</a>
    </div>
    <a href="mailto:aakers@resolve-advisory.com?subject=Request%20a%20conversation" class="nav__cta">Request a conversation</a>
    <button class="nav__hamburger" aria-label="Open menu" onclick="this.closest('.nav').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- HERO -->
  <section class="ins-hero">
    <div class="ins-hero__text">
      <span class="label">Insights</span>
      <div class="rule"></div>
      <h1 class="h1" style="margin-bottom:28px;">How I think about conflict</h1>
      <div class="rule" style="width:28px;"></div>
      <div class="body-text" style="max-width:380px;">
        <p>Essays, observations, and principles drawn from decades of advising people through difficult conversations and high-stakes situations.</p>
      </div>
    </div>
    <div class="ins-hero__image">
      <img class="site-image" src="/assets/images/home-page-3.webp" alt="Quiet study interior with chair, shelves, and warm window light">
    </div>
  </section>

  <!-- INSIGHT COMPLEMENT -->
  <div class="featured">
    <div class="featured__inner">
      <div class="featured__img-wrap">
        <img class="site-image" src="/assets/images/home-page-4.webp" alt="Quiet architectural doorway with warm light and shadow">
      </div>
      <div class="featured__text">
        <h2 class="featured__title">Most conflicts escalate for a simple reason.</h2>
        <div class="featured__rule"></div>
        <p class="featured__excerpt">Escalation is rarely about what people are arguing about. It's about what's underneath it.</p>
      </div>
    </div>
  </div>

  <!-- CTA BANNER -->
  <div class="cta-banner">
    <div class="cta-banner__inner">
      <p class="cta-banner__text">Thoughtful perspective can change the direction of a situation.</p>
      <a href="mailto:aakers@resolve-advisory.com?subject=Request%20a%20conversation" class="btn btn--dark">Request a conversation</a>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer__grid">
      <div class="footer__brand">
        <span class="footer__wordmark"><img src="/assets/images/resolve-white-logo.png" alt="Resolve Advisory"></span>
        <p class="footer__tagline">Strategic advisory for complex situations and difficult conversations.</p>
      </div>
      <div>
        <span class="footer__col-head">Navigation</span>
        <div class="footer__links">
          <a href="/about/">About</a>
          <a href="/situations/">Situations</a>
          <a href="/how-it-works/">How It Works</a>
          <a href="/faq/">FAQ</a>
        </div>
      </div>
      <div>
        <span class="footer__col-head">Legal</span>
        <div class="footer__links">
          <a href="#">Privacy Policy</a>
          <a href="#">Terms of Use</a>
        </div>
      </div>
      <div>
        <span class="footer__col-head">Contact</span>
        <div class="footer__links">
          <a href="tel:+19177508987">P: +1 917 750 8987</a>
          <a href="mailto:aakers@resolve-advisory.com">E: aakers@resolve-advisory.com</a>
        </div>
        <p style="font-size:13.5px;font-weight:400;color:rgba(253,250,247,0.62);line-height:1.7;margin-top:14px;">Address<br>18 6th Avenue #3417,<br>Brooklyn, New York, 11217</p>
      </div>
    </div>
    <div class="footer__bottom">
      <span>© 2026 Resolve Advisory. All rights reserved.</span>
      <a href="#">Privacy</a>
    </div>
  </footer>

<script src="/assets/js/contact-modal.js"></script>
</body>
</html>
