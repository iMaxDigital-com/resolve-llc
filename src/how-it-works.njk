<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pages.howItWorks.seo.title }}</title>
  <meta name="description" content="{{ pages.howItWorks.seo.description }}">
  <link rel="stylesheet" href="/assets/css/styles.css">
  <style>
    /* Hero split */
    .hiw-hero {
      display: grid;
      grid-template-columns: 50fr 50fr;
      min-height: calc(100vh - var(--nav-h));
    }
    .hiw-hero__text {
      padding: clamp(60px,8vw,100px) var(--pad-x);
      display: flex; flex-direction: column; justify-content: center;
    }
    .hiw-hero__image {
      position: relative;
      overflow: hidden;
      min-width: 0;
    }
    .hiw-hero__image .site-image {
      width: 100%;
      height: 100%;
      min-height: calc(100vh - var(--nav-h));
      object-fit: cover;
      object-position: center center;
    }

    /* Process section */
    .process {
      padding: clamp(70px,9vw,110px) var(--pad-x);
      background: var(--cream);
    }
    .process__inner { max-width: var(--max-w); margin: 0 auto; }
    .process__label {
      text-align: center;
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 16px;
    }
    .process__rule {
      width: 42px; height: 1px;
      background: var(--gold);
      margin: 0 auto 60px;
    }
    .process__cols {
      display: grid;
      grid-template-columns: repeat(3,1fr);
      gap: 0;
      border-top: 1px solid var(--divider);
    }
    .process__step {
      padding: 48px 40px 48px 0;
      border-right: 1px solid var(--divider);
    }
    .process__step:last-child { border-right: none; padding-right: 0; }
    .process__num {
      font-family: var(--font-serif);
      font-size: 56px;
      font-weight: 300;
      color: var(--gold);
      line-height: 1;
      margin-bottom: 6px;
    }
    .process__num-rule { width: 28px; height: 1px; background: var(--gold); margin-bottom: 20px; }
    .process__step-title {
      font-family: var(--font-serif);
      font-size: 26px;
      font-weight: 400;
      line-height: 1.2;
      margin-bottom: 18px;
    }
    .process__step-body {
      font-size: clamp(16.5px, 1.1vw, 18px);
      font-weight: 400;
      line-height: 1.78;
      color: rgba(28,28,40,0.86);
    }
    .process__step-body p { margin-bottom: 0.6em; }
    .process__step-list {
      margin-top: 10px;
      display: flex; flex-direction: column; gap: 6px;
    }
    .process__step-list li {
      font-size: clamp(16.5px, 1.1vw, 18px);
      font-weight: 400;
      line-height: 1.7;
      color: rgba(28,28,40,0.84);
      padding-left: 14px;
      position: relative;
    }
    .process__step-list li::before {
      content: '·';
      position: absolute; left: 0;
      color: var(--gold);
    }

    /* Selectivity / Engagement */
    .engagement {
      background: var(--charcoal);
      padding: clamp(70px,9vw,110px) var(--pad-x);
    }
    .engagement__inner {
      max-width: var(--max-w);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
      border-top: 1px solid rgba(253,250,247,0.1);
    }
    .engagement__col {
      padding: 56px 56px 56px 0;
      border-right: 1px solid rgba(253,250,247,0.1);
    }
    .engagement__col:last-child { border-right: none; padding-right: 0; padding-left: 56px; }
    .engagement__title {
      font-family: var(--font-serif);
      font-size: clamp(28px,3vw,40px);
      font-weight: 400;
      color: var(--warm-white);
      margin-bottom: 16px;
    }
    .engagement__rule { width: 36px; height: 1px; background: var(--gold); margin-bottom: 24px; }
    .engagement__body {
      font-size: clamp(16.5px, 1.1vw, 18px);
      font-weight: 400;
      line-height: 1.78;
      color: rgba(253,250,247,0.82);
    }
    .engagement__body p + p { margin-top: 1em; }
    .engagement__list {
      margin-top: 16px;
      display: flex; flex-direction: column; gap: 7px;
    }
    .engagement__list li {
      font-size: clamp(16.5px, 1.1vw, 18px); font-weight: 400;
      color: rgba(253,250,247,0.82);
      padding-left: 14px; position: relative;
      line-height: 1.7;
    }
    .engagement__list li::before { content: '·'; position: absolute; left: 0; color: var(--gold); }
    .engagement__price {
      font-family: var(--font-serif);
      font-size: 36px;
      font-weight: 300;
      color: var(--warm-white);
      margin-top: 24px;
    }
    .engagement__price-note {
      font-size: 13px;
      font-weight: 400;
      color: rgba(253,250,247,0.72);
      margin-top: 6px;
      line-height: 1.6;
    }

    @media (max-width: 960px) {
      .hiw-hero { grid-template-columns: 1fr; }
      .hiw-hero__image { order: 2; min-height: 300px; }
      .hiw-hero__image .site-image { min-height: 340px; }
      .process__cols { grid-template-columns: 1fr; }
      .process__step { border-right: none; border-bottom: 1px solid var(--divider); padding-right: 0; }
      .process__step[style] { padding-left: 0 !important; }
      .process__step:last-child { border-bottom: none; }
      .engagement__inner { grid-template-columns: 1fr; }
      .engagement__col { border-right: none; border-bottom: 1px solid rgba(253,250,247,0.1); padding-right: 0; }
      .engagement__col:last-child { border-bottom: none; padding-left: 0; }
    }
  </style>
</head>
<body class="page">

  <nav class="nav nav--light">
    <a href="/" class="nav__wordmark">
      <img class="nav__logo nav__logo--dark" src="/assets/images/resolve-advisory-logo.png" alt="Resolve Advisory">
      <img class="nav__logo nav__logo--light" src="/assets/images/resolve-white-logo.png" alt="Resolve Advisory">
    </a>
    <div class="nav__links">
      <a href="/">Home</a>
      <a href="/how-it-works/" class="active">How it works</a>
      <a href="/situations/">Situations</a>
      <a href="/about/">About</a>
      <a href="/faq/">FAQ</a>
    </div>
    <a href="mailto:aakers@resolve-advisory.com?subject=Request%20a%20conversation" class="nav__cta">Request a conversation</a>
    <button class="nav__hamburger" aria-label="Open menu" onclick="this.closest('.nav').classList.toggle('open')">
      <span></span><span></span><span></span>
    </button>
  </nav>

  <!-- HERO -->
  <section class="hiw-hero">
    <div class="hiw-hero__text">
      <span class="label">{{ pages.howItWorks.hero.label }}</span>
        <p>{{ pages.howItWorks.hero.kicker | safe }}</p>
      <div class="rule"></div>
      <h1 class="h1" style="margin-bottom:28px;">{{ pages.howItWorks.hero.heading }}</h1>
      <div class="rule" style="width:28px;"></div>
      <div class="body-text" style="max-width:400px;">
        {% for paragraph in pages.howItWorks.hero.paragraphs %}
        <p>{{ paragraph }}</p>
        {% endfor %}
      </div>
    </div>
    <div class="hiw-hero__image">
      <img class="site-image" src="/assets/images/how-it-works-hero.webp" alt="Sunlit interior with warm architectural shadows and a quiet chair">
    </div>
  </section>

  <!-- PROCESS -->
  <div class="process">
    <div class="process__inner">
      <div class="process__label">{{ pages.howItWorks.process.label }}</div>
      <div class="process__rule"></div>
      <div class="process__cols">
        {% for step in pages.howItWorks.process.steps %}
        <div class="process__step"{% if not loop.first %} style="padding-left:40px;"{% endif %}>
          <div class="process__num">{{ step.number }}</div>
          <div class="process__num-rule"></div>
          <div class="process__step-title">{{ step.title }}</div>
          {% if step.bodyBefore.length %}
          <div class="process__step-body">
            {% for paragraph in step.bodyBefore %}
            <p>{{ paragraph }}</p>
            {% endfor %}
          </div>
          {% endif %}
          {% if step.items.length %}
          <ul class="process__step-list">
            {% for item in step.items %}
            <li>{{ item }}</li>
            {% endfor %}
          </ul>
          {% endif %}
          {% if step.bodyAfter.length %}
          <div class="process__step-body" style="margin-top:{% if loop.index == 2 %}18{% else %}12{% endif %}px;">
            {% for paragraph in step.bodyAfter %}
            <p>{{ paragraph }}</p>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- SELECTIVITY + ENGAGEMENT -->
  <div class="engagement">
    <div class="engagement__inner">
      {% for column in pages.howItWorks.engagement.columns %}
      <div class="engagement__col">
        <div class="engagement__title">{{ column.title }}</div>
        <div class="engagement__rule"></div>
        <div class="engagement__body">
          {% for paragraph in column.paragraphs %}
          <p>{{ paragraph }}</p>
          {% endfor %}
        </div>
        {% if column.items.length %}
        <ul class="engagement__list">
          {% for item in column.items %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- CTA BANNER -->
  <div class="cta-banner">
    <div class="cta-banner__inner">
      <p class="cta-banner__text">{{ pages.howItWorks.ctaBanner.text }}</p>
      <a href="mailto:aakers@resolve-advisory.com?subject=Request%20a%20conversation" class="btn btn--dark">{{ pages.howItWorks.ctaBanner.ctaLabel }}</a>
    </div>
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer__grid">
      <div class="footer__brand">
        <span class="footer__wordmark"><img src="/assets/images/resolve-white-logo.png" alt="Resolve Advisory"></span>
        <p class="footer__tagline">Strategic advisory for complex situations and difficult conversations.</p>
      </div>
      <div>
        <span class="footer__col-head">Navigation</span>
        <div class="footer__links">
          <a href="/about/">About</a>
          <a href="/situations/">Situations</a>
          <a href="/how-it-works/">How It Works</a>
          <a href="/faq/">FAQ</a>
        </div>
      </div>
      <div>
        <span class="footer__col-head">Disclaimer</span>
        <p class="footer__disclaimer">Resolve Advisory does not provide legal, tax, investment, psychological, or therapeutic advice.</p>
      </div>
      <div>
        <span class="footer__col-head">Contact</span>
        <div class="footer__links">
          <a href="tel:+19177508987">P: +1 917 750 8987</a>
          <a href="mailto:aakers@resolve-advisory.com">E: aakers@resolve-advisory.com</a>
        </div>
      </div>
    </div>
    {% include "footer-newsletter.njk" %}

    <div class="footer__bottom">
      <span>© 2026 Resolve Advisory. All rights reserved.</span>
      <a href="#">Privacy</a>
    </div>
  </footer>

<script src="/assets/js/contact-modal-data.js"></script>
<script src="/assets/js/contact-modal.js"></script>
  <script src="/assets/js/nav-scroll.js"></script>
</body>
</html>
