<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pages.insights.seo.title }}</title>
  <meta name="description" content="{{ pages.insights.seo.description }}">
  <link rel="stylesheet" href="/assets/css/styles.css">
  <style>
    /* Hero */
    .ins-hero {
      display: grid;
      grid-template-columns: 50fr 50fr;
      min-height: calc(100vh - var(--nav-h));
    }
    .ins-hero__text {
      padding: clamp(60px,8vw,100px) var(--pad-x);
      display: flex; flex-direction: column; justify-content: center;
    }
    .ins-hero__image {
      position: relative;
      overflow: hidden;
      min-width: 0;
    }
    .ins-hero__image .site-image {
      width: 100%;
      height: 100%;
      min-height: calc(100vh - var(--nav-h));
      object-fit: cover;
      object-position: center center;
    }

    /* Featured insight */
    .featured {
      padding: clamp(70px,9vw,110px) var(--pad-x);
      background: var(--cream);
    }
    .featured__inner {
      max-width: var(--max-w);
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 72px;
      align-items: center;
    }
    .featured__title {
      font-family: var(--font-serif);
      font-size: clamp(28px,3.2vw,46px);
      font-weight: 400;
      line-height: 1.1;
      margin-bottom: 20px;
    }
    .featured__rule {
      width: 36px;
      height: 1px;
      background: var(--gold);
      margin-bottom: 20px;
    }
    .featured__excerpt {
      font-size: clamp(17px, 1.18vw, 19px);
      font-weight: 400;
      line-height: 1.78;
      color: rgba(28,28,40,0.86);
      margin-bottom: 28px;
    }

    /* Insights list (Recent thinking) */
    .featured__inner.insights-list {
      display: block;
    }
    .insights-list__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 28px;
    }
    .insights-list__card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: #fff;
    }
    .insights-list__cover {
      width: 100%;
      aspect-ratio: 4/3;
      object-fit: cover;
      display: block;
    }
    .insights-list__body {
      padding: 28px;
    }

    @media (max-width: 960px) {
      .ins-hero { grid-template-columns: 1fr; }
      .ins-hero__image { order: 2; min-height: 300px; }
      .ins-hero__image .site-image { min-height: 340px; }
      .insights-list__grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 640px) {
      .insights-list__grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body class="page">

  {% set navTheme = "light" %}
  {% set navActive = "insights" %}
  {% include "site-header.njk" %}

  <!-- HERO -->
  <section class="ins-hero">
    <div class="ins-hero__text">
      <span class="label">{{ pages.insights.hero.label }}</span>
      <div class="rule"></div>
      <h1 class="h1" style="margin-bottom:28px;">{{ pages.insights.hero.heading }}</h1>
      <div class="rule" style="width:28px;"></div>
      <div class="body-text" style="max-width:380px;">
        {% for paragraph in pages.insights.hero.paragraphs %}
        <p>{{ paragraph }}</p>
        {% endfor %}
      </div>
    </div>
    <div class="ins-hero__image">
      <img class="site-image" src="/assets/images/home-page-3.webp" alt="Quiet study interior with chair, shelves, and warm window light">
    </div>
  </section>

  <!-- INSIGHTS LIST -->
  <section class="featured">
    <div class="featured__inner insights-list">
      <div style="max-width:680px;margin-bottom:48px;">
        <span class="label">{{ pages.insights.listIntro.label }}</span>
        <div class="rule"></div>
        <h2 class="featured__title">{{ pages.insights.listIntro.heading }}</h2>
      </div>

      <div class="insights-list__grid">
        {% for post in collections.posts | reverse %}
          {% if post.data.published %}
            <a href="{{ post.url }}" class="insights-list__card">
              {% if post.data.coverImage %}
                <img src="{{ post.data.coverImage }}" alt="{{ post.data.title }}" class="insights-list__cover">
              {% endif %}

              <div class="insights-list__body">
                <h3 class="featured__title" style="font-size:28px;">{{ post.data.title | truncate(70) }}</h3>

                {% if post.data.description %}
                  <p class="featured__excerpt">{{ post.data.description | truncate(140) }}</p>
                {% endif %}
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <div class="cta-banner">
    <div class="cta-banner__inner">
      <p class="cta-banner__text">{{ pages.insights.ctaBanner.text }}</p>
      <a href="mailto:aakers@resolve-advisory.com?subject=Request%20a%20conversation" class="btn btn--dark">{{ pages.insights.ctaBanner.ctaLabel }}</a>
    </div>
  </div>

  <!-- FOOTER -->
  {% include "site-footer.njk" %}

<script src="/assets/js/contact-modal-data.js"></script>
<script src="/assets/js/contact-modal.js"></script>
  <script src="/assets/js/nav-scroll.js"></script>
</body>
</html>
